						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "LS_AzureKeyVault1",
							"type": "LinkedServiceReference"
						},
						"secretName": "metadatadb-password",
						"secretVersion": "3575c512ec4a45bdb8915235c07f7c8f"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_AzureKeyVault1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/la_PostgreSql1')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "PostgreSqlV2",
				"typeProperties": {
					"server": "[parameters('la_PostgreSql1_properties_typeProperties_server')]",
					"port": 5432,
					"database": "[parameters('la_PostgreSql1_properties_typeProperties_database')]",
					"username": "[parameters('la_PostgreSql1_properties_typeProperties_username')]",
